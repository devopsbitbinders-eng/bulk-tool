{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/callback.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/callback",
      "dest": "api/callback.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  }
}
